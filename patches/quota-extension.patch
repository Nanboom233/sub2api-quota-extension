diff --git a/frontend/src/components/account/QuotaScriptEditor.vue b/frontend/src/components/account/QuotaScriptEditor.vue
new file mode 100644
index 0000000..7dd3b29
--- /dev/null
+++ b/frontend/src/components/account/QuotaScriptEditor.vue
@@ -0,0 +1,107 @@
+<script setup lang="ts">
+import { computed, onBeforeUnmount, ref, useId, watch } from 'vue'
+import { useI18n } from 'vue-i18n'
+import { adminAPI } from '@/api/admin'
+import type { QuotaScriptTestParams } from '@/api/admin/accounts'
+import type { AccountUsageInfo } from '@/types'
+import HelpTooltip from '@/components/common/HelpTooltip.vue'
+import UpstreamQuotaUsage from './UpstreamQuotaUsage.vue'
+
+const props = defineProps<{ connection: Omit<QuotaScriptTestParams, 'script'>; active?: boolean }>()
+const model = defineModel<string>({ default: '' })
+const { t } = useI18n()
+const inputID = useId()
+const testing = ref(false)
+const usage = ref<AccountUsageInfo | null>(null)
+const error = ref('')
+let request = 0
+let inFlight = 0
+const example = `function queryQuota(ctx) {
+  const response = http.request({
+    url: ctx.baseUrl.replace(/\\/$/, '') + '/balance',
+    headers: { Authorization: 'Bearer ' + ctx.apiKey }
+  });
+  if (response.status !== 200) throw new Error('HTTP ' + response.status);
+  const data = JSON.parse(response.body);
+  return { balance: Number(data.remaining) };
+}`
+const tokens = computed(() => {
+  const source = (model.value || example) + '\n'
+  const pattern = /\/\/[^\n]*|\/\*[\s\S]*?\*\/|'(?:\\.|[^'\\])*'|"(?:\\.|[^"\\])*"|`(?:\\.|[^`\\])*`|\b(?:function|const|let|var|return|if|else|throw|new|true|false|null|undefined)\b|\b\d+(?:\.\d+)?\b/g
+  const parts: { text: string; color: string }[] = []
+  let offset = 0
+  for (const match of source.matchAll(pattern)) {
+    const start = match.index!
+    if (start > offset) parts.push({ text: source.slice(offset, start), color: '' })
+    const text = match[0]
+    const color = text.startsWith('/') ? 'text-gray-400'
+      : /^["'`]/.test(text) ? 'text-emerald-600 dark:text-emerald-400'
+      : /^\d/.test(text) ? 'text-amber-600 dark:text-amber-400'
+      : 'text-purple-600 dark:text-purple-400'
+    parts.push({ text, color })
+    offset = start + text.length
+  }
+  parts.push({ text: source.slice(offset), color: '' })
+  return parts
+})
+
+watch([model, () => props.connection, () => props.active], () => {
+  request++
+  usage.value = null
+  error.value = ''
+}, { deep: true, flush: 'sync' })
+onBeforeUnmount(() => { request++ })
+
+async function testScript() {
+  if (!model.value.trim() || inFlight > 0) return
+  const current = ++request
+  inFlight++
+  testing.value = true
+  usage.value = null
+  error.value = ''
+  try {
+    const result = await adminAPI.accounts.testQuotaScript({ ...props.connection, script: model.value })
+    if (current === request) usage.value = result
+  } catch (failure: unknown) {
+    if (current === request) {
+      error.value = (failure as { message?: string })?.message || t('common.error')
+    }
+  } finally {
+    inFlight--
+    if (inFlight === 0) testing.value = false
+  }
+}
+</script>
+
+<template>
+  <div>
+    <div class="flex items-center">
+      <label :for="inputID" class="input-label">{{ t('admin.accounts.quotaScript.label') }}</label>
+      <HelpTooltip width-class="w-max max-w-[calc(100vw-2rem)]">
+        <p class="whitespace-pre-line">{{ t('admin.accounts.quotaScript.help') }}</p>
+      </HelpTooltip>
+    </div>
+    <div class="grid">
+      <pre
+        aria-hidden="true"
+        :class="['input pointer-events-none m-0 overflow-hidden whitespace-pre-wrap break-words font-mono text-xs', { 'opacity-40': !model }]"
+        style="grid-area: 1 / 1; overflow-wrap: anywhere"
+      ><span v-for="(token, index) in tokens" :key="index" :class="token.color">{{ token.text }}</span></pre>
+      <textarea
+        :id="inputID"
+        v-model="model"
+        :aria-label="t('admin.accounts.quotaScript.label')"
+        :placeholder="example"
+        rows="1"
+        spellcheck="false"
+        class="input resize-none overflow-hidden bg-transparent font-mono text-xs text-transparent caret-gray-900 placeholder:text-transparent dark:bg-transparent dark:text-transparent dark:caret-gray-100 dark:placeholder:text-transparent"
+        style="grid-area: 1 / 1; overflow-wrap: anywhere"
+      />
+    </div>
+    <button type="button" class="btn btn-secondary btn-sm mt-2" :disabled="!model.trim() || testing" @click="testScript">
+      {{ testing ? t('common.loading') : t('admin.accounts.quotaScript.test') }}
+    </button>
+    <p v-if="error" class="mt-2 text-xs text-amber-600 dark:text-amber-400" role="alert">{{ error }}</p>
+    <UpstreamQuotaUsage v-if="usage" :usage="usage" show-error class="mt-2" />
+  </div>
+</template>
