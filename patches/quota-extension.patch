+func lockAPIKeyQuotaSchedulingSources(ctx context.Context, client *dbent.Client, account *service.Account, credentialsJSON string) (map[string]any, bool, error) {
+	var proxyID any
+	if account.ProxyID != nil {
+		proxyID = *account.ProxyID
+	}
+	rows, err := client.QueryContext(ctx, `SELECT extra FROM accounts
+		WHERE id = $1 AND deleted_at IS NULL AND platform = $2 AND type = $3
+		AND COALESCE(credentials, '{}'::jsonb) = $4::jsonb AND proxy_id IS NOT DISTINCT FROM $5
+		AND CASE WHEN BTRIM(COALESCE(extra ->> 'quota_script', '')) = '' THEN '' ELSE COALESCE(extra ->> 'quota_script', '') END = $6
+		FOR NO KEY UPDATE`, account.ID, account.Platform, account.Type, credentialsJSON, proxyID, normalizedAccountQuotaScript(account.Extra))
+	if err != nil {
+		return nil, false, err
+	}
+	defer func() { _ = rows.Close() }()
+	if !rows.Next() {
+		return nil, false, rows.Err()
+	}
+	var rawExtra []byte
+	if err := rows.Scan(&rawExtra); err != nil {
+		return nil, false, err
+	}
+	current := map[string]any{}
+	if len(rawExtra) != 0 {
+		if err := json.Unmarshal(rawExtra, &current); err != nil {
+			return nil, false, err
+		}
+	}
+	return current, true, rows.Err()
+}
