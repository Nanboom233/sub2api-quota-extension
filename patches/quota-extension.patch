@@ -0,0 +1,94 @@
+package admin
+
+import (
+	"encoding/json"
+	"maps"
+	"net/http"
+	"strings"
+
+	"github.com/Wei-Shaw/sub2api/internal/pkg/response"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+)
+
+func (h *AccountHandler) TestQuotaScript(c *gin.Context) {
+	var request struct {
+		Script    string          `json:"script"`
+		AccountID *int64          `json:"account_id"`
+		APIKey    string          `json:"api_key"`
+		BaseURL   string          `json:"base_url"`
+		ProxyID   json.RawMessage `json:"proxy_id"`
+		Extra     map[string]any  `json:"extra"`
+	}
+	if err := c.ShouldBindJSON(&request); err != nil {
+		response.BadRequest(c, "Invalid quota script test request")
+		return
+	}
+	if strings.TrimSpace(request.Script) == "" {
+		response.BadRequest(c, "Quota script is empty")
+		return
+	}
+	account := &service.Account{Type: service.AccountTypeAPIKey}
+	if request.AccountID != nil {
+		stored, err := h.adminService.GetAccount(c.Request.Context(), *request.AccountID)
+		if err != nil {
+			response.ErrorFrom(c, err)
+			return
+		}
+		if stored.Type != service.AccountTypeAPIKey {
+			response.BadRequest(c, "Quota scripts require an API-key account")
+			return
+		}
+		*account = *stored
+	}
+	account.Credentials = maps.Clone(account.Credentials)
+	if account.Credentials == nil {
+		account.Credentials = make(map[string]any)
+	}
+	if strings.TrimSpace(request.APIKey) != "" {
+		account.Credentials["api_key"] = request.APIKey
+	}
+	if strings.TrimSpace(request.BaseURL) != "" {
+		account.Credentials["base_url"] = request.BaseURL
+		if account.RoutesProtocolByInbound() && account.IsAdaptiveAPIProtocol() {
+			baseURLs, _ := account.Credentials["api_base_urls"].(map[string]any)
+			baseURLs = maps.Clone(baseURLs)
+			if baseURLs == nil {
+				baseURLs = make(map[string]any)
+			}
+			baseURLs[service.APIProtocolChatCompletions] = request.BaseURL
+			account.Credentials["api_base_urls"] = baseURLs
+		}
+	}
+	account.Extra = maps.Clone(account.Extra)
+	if account.Extra == nil {
+		account.Extra = make(map[string]any)
+	}
+	maps.Copy(account.Extra, request.Extra)
+	if len(request.ProxyID) > 0 {
+		var proxyID *int64
+		if err := json.Unmarshal(request.ProxyID, &proxyID); err != nil {
+			response.BadRequest(c, "proxy_id must be an ID or null")
+			return
+		}
+		account.ProxyID, account.Proxy = proxyID, nil
+	}
+	if account.ProxyID != nil && (account.Proxy == nil || account.Proxy.ID != *account.ProxyID) {
+		proxy, err := h.adminService.GetProxy(c.Request.Context(), *account.ProxyID)
+		if err != nil {
+			response.ErrorFrom(c, err)
+			return
+		}
+		account.Proxy = proxy
+	}
+	if h.accountUsageService == nil {
+		response.InternalError(c, "Account usage service is not configured")
+		return
+	}
+	usage, err := h.accountUsageService.ExecuteQuotaScript(c.Request.Context(), account, request.Script)
+	if err != nil {
+		response.Error(c, http.StatusBadGateway, err.Error())
+		return
+	}
+	response.Success(c, usage)
+}
