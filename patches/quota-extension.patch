diff --git a/backend/internal/service/account_upstream_quota.go b/backend/internal/service/account_upstream_quota.go
new file mode 100644
index 0000000..046aeae
--- /dev/null
+++ b/backend/internal/service/account_upstream_quota.go
@@ -0,0 +1,193 @@
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"math"
+	"net/http"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/pkg/tlsfingerprint"
+)
+
+type upstreamQuotaAmount struct {
+	Limit     *float64   `json:"limit"`
+	Used      *float64   `json:"used"`
+	Remaining *float64   `json:"remaining"`
+	Unit      string     `json:"unit"`
+	Window    string     `json:"window"`
+	ResetAt   *time.Time `json:"reset_at"`
+}
+
+type upstreamQuotaResponse struct {
+	Mode         string                `json:"mode"`
+	Unit         string                `json:"unit"`
+	Balance      *float64              `json:"balance"`
+	Remaining    *float64              `json:"remaining"`
+	Quota        *upstreamQuotaAmount  `json:"quota"`
+	RateLimits   []upstreamQuotaAmount `json:"rate_limits"`
+	Subscription *struct {
+		DailyUsed    *float64 `json:"daily_usage_usd"`
+		DailyLimit   *float64 `json:"daily_limit_usd"`
+		WeeklyUsed   *float64 `json:"weekly_usage_usd"`
+		WeeklyLimit  *float64 `json:"weekly_limit_usd"`
+		MonthlyUsed  *float64 `json:"monthly_usage_usd"`
+		MonthlyLimit *float64 `json:"monthly_limit_usd"`
+	} `json:"subscription"`
+}
+
+func parseUpstreamQuota(body []byte, now time.Time) (*UsageInfo, error) {
+	var response upstreamQuotaResponse
+	if err := json.Unmarshal(body, &response); err != nil {
+		return nil, err
+	}
+	if response.Mode != "quota_limited" && response.Mode != "unrestricted" {
+		return nil, errors.New("unknown quota mode")
+	}
+	if response.Unit != "" && response.Unit != "USD" {
+		return nil, errors.New("unknown quota unit")
+	}
+	usage := &UsageInfo{UpdatedAt: &now}
+	progress := func(amount upstreamQuotaAmount) (*UsageProgress, error) {
+		if amount.Unit != "" && amount.Unit != "USD" {
+			return nil, errors.New("unknown quota unit")
+		}
+		if amount.Used != nil && *amount.Used < 0 || amount.Limit != nil && *amount.Limit < 0 {
+			return nil, errors.New("negative quota usage or limit")
+		}
+		if amount.Used == nil || amount.Limit == nil || *amount.Limit == 0 {
+			return nil, nil
+		}
+		result := &UsageProgress{Utilization: *amount.Used / *amount.Limit * 100, ResetsAt: amount.ResetAt}
+		if math.IsInf(result.Utilization, 0) {
+			return nil, errors.New("invalid quota utilization")
+		}
+		if result.ResetsAt != nil {
+			result.RemainingSeconds = max(0, int(result.ResetsAt.Sub(now).Seconds()))
+		}
+		return result, nil
+	}
+	if response.Mode == "quota_limited" {
+		if response.Quota != nil {
+			var err error
+			usage.QuotaTotal, err = progress(*response.Quota)
+			if err != nil {
+				return nil, err
+			}
+		}
+		if response.Remaining != nil && *response.Remaining >= 0 {
+			usage.Balance = response.Remaining
+		}
+		for _, amount := range response.RateLimits {
+			window, err := progress(amount)
+			if err != nil {
+				return nil, err
+			}
+			switch amount.Window {
+			case "5h":
+				usage.FiveHour = window
+			case "1d":
+				usage.OneDay = window
+			case "7d":
+				usage.SevenDay = window
+			}
+		}
+	} else if subscription := response.Subscription; subscription != nil {
+		var err error
+		usage.OneDay, err = progress(upstreamQuotaAmount{Used: subscription.DailyUsed, Limit: subscription.DailyLimit})
+		if err != nil {
+			return nil, err
+		}
+		usage.SevenDay, err = progress(upstreamQuotaAmount{Used: subscription.WeeklyUsed, Limit: subscription.WeeklyLimit})
+		if err != nil {
+			return nil, err
+		}
+		usage.ThirtyDay, err = progress(upstreamQuotaAmount{Used: subscription.MonthlyUsed, Limit: subscription.MonthlyLimit})
+		if err != nil {
+			return nil, err
+		}
+	} else {
+		usage.Balance = response.Balance
+	}
+	return usage, nil
+}
+
+func (s *AccountUsageService) fillUpstreamAPIKeyUsage(ctx context.Context, account *Account, baseURL string, usage *UsageInfo) {
+	if s.upstreamHTTP == nil {
+		return
+	}
+	baseURL, err := validateAccountUpstreamBaseURL(s.upstreamConfig, baseURL)
+	if err != nil {
+		return
+	}
+	apiKey := account.GetCredential("api_key")
+	if apiKey == "" {
+		return
+	}
+	proxyURL := ""
+	if account.ProxyID != nil {
+		if account.Proxy == nil || account.Proxy.ID != *account.ProxyID {
+			return
+		}
+		proxyURL = account.Proxy.URL()
+	}
+	requestCtx, cancel := context.WithTimeout(ctx, upstreamBillingProbeRequestTimeout)
+	defer cancel()
+	req, err := http.NewRequestWithContext(requestCtx, http.MethodGet, buildOpenAIEndpointURL(baseURL, "/v1/usage"), nil)
+	if err != nil {
+		return
+	}
+	profile := HTTPUpstreamProfileDefault
+	if account.Platform == PlatformOpenAI {
+		profile = HTTPUpstreamProfileOpenAI
+	}
+	req = req.WithContext(WithHTTPUpstreamRedirectsDisabled(WithHTTPUpstreamProfile(req.Context(), profile)))
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("Authorization", "Bearer "+apiKey)
+	account.ApplyHeaderOverrides(req.Header)
+	var tlsProfile *tlsfingerprint.Profile
+	if s.tlsFPProfileService != nil {
+		tlsProfile = s.tlsFPProfileService.ResolveTLSProfile(account)
+	}
+	resp, err := s.upstreamHTTP.DoWithTLS(req, proxyURL, account.ID, account.Concurrency, tlsProfile)
+	if resp != nil && resp.Body != nil {
+		defer resp.Body.Close()
+	}
+	if err != nil {
+		return
+	}
+	if resp == nil || resp.Body == nil {
+		return
+	}
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return
+	}
+	body, err := io.ReadAll(io.LimitReader(resp.Body, upstreamBillingProbeMaxBodyBytes+1))
+	if err != nil {
+		return
+	}
+	if len(body) > upstreamBillingProbeMaxBodyBytes {
+		return
+	}
+	remote, err := parseUpstreamQuota(body, time.Now())
+	if err != nil {
+		return
+	}
+	if remote.FiveHour != nil {
+		usage.FiveHour = remote.FiveHour
+	}
+	if remote.OneDay != nil {
+		usage.OneDay = remote.OneDay
+	}
+	if remote.SevenDay != nil {
+		usage.SevenDay = remote.SevenDay
+	}
+	if remote.ThirtyDay != nil {
+		usage.ThirtyDay = remote.ThirtyDay
+	}
+	usage.QuotaTotal = remote.QuotaTotal
+	usage.Balance = remote.Balance
+	usage.UpdatedAt = remote.UpdatedAt
+}
