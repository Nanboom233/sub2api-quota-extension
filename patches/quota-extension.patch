+func (a *Account) isAPIKeyQuotaExhausted(now time.Time) bool {
+	if a == nil || len(a.Extra) == 0 {
+		return false
+	}
+	if exhausted, ok := a.Extra[APIKeyQuotaExhaustedExtraKey].(bool); ok && exhausted {
+		return true
+	}
+	for _, spec := range []struct {
+		usedKey    string
+		resetAtKey string
+	}{
+		{APIKeyQuota5hUsedPercentExtraKey, APIKeyQuota5hResetAtExtraKey},
+		{APIKeyQuota1dUsedPercentExtraKey, APIKeyQuota1dResetAtExtraKey},
+		{APIKeyQuota7dUsedPercentExtraKey, APIKeyQuota7dResetAtExtraKey},
+		{APIKeyQuota30dUsedPercentExtraKey, APIKeyQuota30dResetAtExtraKey},
+		{APIKeyQuotaTotalUsedPercentExtraKey, APIKeyQuotaTotalResetAtExtraKey},
+	} {
+		rawUsed, ok := a.Extra[spec.usedKey]
+		if !ok || rawUsed == nil {
+			continue
+		}
+		if parseExtraFloat64(rawUsed) < 100 {
+			continue
+		}
+		resetAt := parseSchedulingResetAt(a.Extra[spec.resetAtKey])
+		if resetAt == nil || resetAt.After(now) {
+			return true
+		}
+	}
+	return false
+}
