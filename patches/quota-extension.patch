+	Used      *float64   `json:"used"`
+	Remaining *float64   `json:"remaining"`
+	Unit      string     `json:"unit"`
+	Window    string     `json:"window"`
+	ResetAt   *time.Time `json:"reset_at"`
+}
+
+type upstreamQuotaResponse struct {
+	Mode         string                `json:"mode"`
+	Unit         string                `json:"unit"`
+	Balance      *float64              `json:"balance"`
+	Remaining    *float64              `json:"remaining"`
+	ExpiresAt    *time.Time            `json:"expires_at"`
+	Quota        *upstreamQuotaAmount  `json:"quota"`
+	RateLimits   []upstreamQuotaAmount `json:"rate_limits"`
+	Subscription *struct {
+		DailyUsed         *float64   `json:"daily_usage_usd"`
+		DailyLimit        *float64   `json:"daily_limit_usd"`
+		WeeklyUsed        *float64   `json:"weekly_usage_usd"`
+		WeeklyLimit       *float64   `json:"weekly_limit_usd"`
+		MonthlyUsed       *float64   `json:"monthly_usage_usd"`
+		MonthlyLimit      *float64   `json:"monthly_limit_usd"`
+		WeeklyWindowStart *time.Time `json:"weekly_window_start"`
+		ExpiresAt         *time.Time `json:"expires_at"`
+	} `json:"subscription"`
+}
+
+type upstreamQuotaResult struct {
+	*UsageInfo
+	ExpiresAt *time.Time
+}
+
+func parseUpstreamQuota(body []byte, now time.Time) (*upstreamQuotaResult, error) {
+	var response upstreamQuotaResponse
+	if err := json.Unmarshal(body, &response); err != nil {
+		return nil, err
+	}
+	if response.Mode != "quota_limited" && response.Mode != "unrestricted" {
+		return nil, errors.New("unknown quota mode")
+	}
+	if response.Unit != "" && response.Unit != "USD" {
+		return nil, errors.New("unknown quota unit")
+	}
+	usage := &upstreamQuotaResult{UsageInfo: &UsageInfo{UpdatedAt: &now}, ExpiresAt: response.ExpiresAt}
+	if subscription := response.Subscription; subscription != nil && subscription.ExpiresAt != nil {
+		if usage.ExpiresAt == nil || subscription.ExpiresAt.Before(*usage.ExpiresAt) {
+			usage.ExpiresAt = subscription.ExpiresAt
+		}
+	}
+	progress := func(amount upstreamQuotaAmount) (*UsageProgress, error) {
+		if amount.Unit != "" && amount.Unit != "USD" {
+			return nil, errors.New("unknown quota unit")
+		}
+		if amount.Used != nil && *amount.Used < 0 || amount.Limit != nil && *amount.Limit < 0 {
+			return nil, errors.New("negative quota usage or limit")
+		}
+		if amount.Used == nil || amount.Limit == nil || *amount.Limit == 0 {
+			return nil, nil
+		}
+		result := &UsageProgress{Utilization: *amount.Used / *amount.Limit * 100, ResetsAt: amount.ResetAt}
+		if math.IsInf(result.Utilization, 0) {
+			return nil, errors.New("invalid quota utilization")
+		}
+		if result.ResetsAt != nil {
+			result.RemainingSeconds = max(0, int(result.ResetsAt.Sub(now).Seconds()))
+		}
+		return result, nil
+	}
+	if response.Mode == "quota_limited" {
+		if response.Quota != nil {
+			var err error
+			usage.QuotaTotal, err = progress(*response.Quota)
+			if err != nil {
+				return nil, err
+			}
+		}
+		if response.Remaining != nil && *response.Remaining >= 0 {
+			usage.Balance = response.Remaining
+		}
+		for _, amount := range response.RateLimits {
+			window, err := progress(amount)
+			if err != nil {
+				return nil, err
+			}
+			switch amount.Window {
+			case "5h":
+				usage.FiveHour = window
+			case "1d":
+				usage.OneDay = window
+			case "7d":
+				usage.SevenDay = window
+			}
+		}
+	} else if subscription := response.Subscription; subscription != nil {
+		// Use a direct seven-day offset for the reported subscription anchor.
+		// This display estimate does not apply the native legacy StartsAt correction.
+		var weeklyResetAt *time.Time
+		if subscription.WeeklyWindowStart != nil {
+			resetAt := subscription.WeeklyWindowStart.Add(7 * 24 * time.Hour)
+			weeklyResetAt = &resetAt
+		}
+
+		var err error
+		usage.OneDay, err = progress(upstreamQuotaAmount{Used: subscription.DailyUsed, Limit: subscription.DailyLimit})
+		if err != nil {
+			return nil, err
+		}
+		usage.SevenDay, err = progress(upstreamQuotaAmount{Used: subscription.WeeklyUsed, Limit: subscription.WeeklyLimit, ResetAt: weeklyResetAt})
+		if err != nil {
+			return nil, err
+		}
+		usage.ThirtyDay, err = progress(upstreamQuotaAmount{Used: subscription.MonthlyUsed, Limit: subscription.MonthlyLimit})
+		if err != nil {
+			return nil, err
+		}
+	} else {
+		usage.Balance = response.Balance
+	}
+	return usage, nil
+}
+
+func upstreamAPIKeyUsageProbeIdentity(account *Account) string {
+	identity := upstreamBillingProbeIdentity(account)
+	if identity == nil {
+		return ""
+	}
+	payload, err := json.Marshal(identity)
+	if err != nil {
+		return ""
+	}
+	sum := sha256.Sum256(payload)
+	return hex.EncodeToString(sum[:])
+}
+
+func isAPIKeyUsageUnsupportedMemoized(account *Account) bool {
+	if account == nil || len(account.Extra) == 0 {
+		return false
+	}
+	saved, ok := account.Extra[APIKeyUsageUnsupportedIdentityExtraKey].(string)
+	return ok && saved != "" && saved == upstreamAPIKeyUsageProbeIdentity(account)
+}
+
+func saveAPIKeyQuotaState(ctx context.Context, repo AccountRepository, account *Account, usage *UsageInfo, expiresAt *time.Time, unsupported *string) {
+	if account == nil || account.ID <= 0 || repo == nil {
+		return
+	}
+	writer, ok := repo.(apiKeyQuotaStateWriter)
+	if !ok {
+		log.Printf("[Quota] account_id=%d: quota persistence is unavailable", account.ID)
+		return
+	}
+	if _, err := writer.UpdateAPIKeyQuotaState(ctx, account, usage, expiresAt, unsupported); err != nil {
+		log.Printf("[Quota] account_id=%d: save quota state: %v", account.ID, err)
+	}
+}
+
+func memoizeUpstreamProbeUnsupported(ctx context.Context, repo AccountRepository, account *Account) {
+	identity := upstreamAPIKeyUsageProbeIdentity(account)
+	if account == nil || identity == "" {
+		return
+	}
+	if account.Extra != nil {
+		if saved, ok := account.Extra[APIKeyUsageUnsupportedIdentityExtraKey].(string); ok && saved == identity {
+			return
+		}
+	}
+	saveAPIKeyQuotaState(ctx, repo, account, nil, nil, &identity)
+}
+
+func clearUpstreamProbeUnsupported(ctx context.Context, repo AccountRepository, account *Account) {
+	if account == nil || len(account.Extra) == 0 {
+		return
+	}
+	saved, ok := account.Extra[APIKeyUsageUnsupportedIdentityExtraKey].(string)
+	if !ok || saved == "" {
+		return
+	}
+	identity := ""
+	saveAPIKeyQuotaState(ctx, repo, account, nil, nil, &identity)
+}
+
+func (s *AccountUsageService) fillUpstreamAPIKeyUsage(ctx context.Context, account *Account, baseURL string, usage *UsageInfo, forceProbe bool) {
+	if s.upstreamHTTP == nil {
+		return
+	}
+	baseURL, err := validateAccountUpstreamBaseURL(s.upstreamConfig, baseURL)
+	if err != nil {
+		return
+	}
+	apiKey := account.GetCredential("api_key")
+	if apiKey == "" {
+		return
+	}
+	proxyURL := ""
+	if account.ProxyID != nil {
+		if account.Proxy == nil || account.Proxy.ID != *account.ProxyID {
+			return
+		}
+		proxyURL = account.Proxy.URL()
+	}
+	if !forceProbe && isAPIKeyUsageUnsupportedMemoized(account) {
+		return
+	}
+	requestCtx, cancel := context.WithTimeout(ctx, upstreamBillingProbeRequestTimeout)
+	defer cancel()
+	req, err := http.NewRequestWithContext(requestCtx, http.MethodGet, buildOpenAIEndpointURL(baseURL, "/v1/usage"), nil)
+	if err != nil {
+		return
+	}
+	profile := HTTPUpstreamProfileDefault
+	if account.Platform == PlatformOpenAI {
+		profile = HTTPUpstreamProfileOpenAI
+	}
+	req = req.WithContext(WithHTTPUpstreamRedirectsDisabled(WithHTTPUpstreamProfile(req.Context(), profile)))
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("Authorization", "Bearer "+apiKey)
+	account.ApplyHeaderOverrides(req.Context(), req.Header)
+	var tlsProfile *tlsfingerprint.Profile
+	if s.tlsFPProfileService != nil {
+		tlsProfile = s.tlsFPProfileService.ResolveTLSProfile(account)
+	}
+	resp, err := s.upstreamHTTP.DoWithTLS(req, proxyURL, account.ID, account.Concurrency, tlsProfile)
+	if resp != nil && resp.Body != nil {
+		defer resp.Body.Close()
+	}
+	if err != nil {
+		return
+	}
+	if resp == nil || resp.Body == nil {
+		return
+	}
+	if resp.StatusCode == http.StatusNotFound || resp.StatusCode == http.StatusMethodNotAllowed || resp.StatusCode == http.StatusNotImplemented {
+		memoizeUpstreamProbeUnsupported(ctx, s.accountRepo, account)
+		return
+	}
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return
+	}
+	body, err := io.ReadAll(io.LimitReader(resp.Body, upstreamBillingProbeMaxBodyBytes+1))
+	if err != nil {
+		return
+	}
+	if len(body) > upstreamBillingProbeMaxBodyBytes {
+		return
+	}
+	now := time.Now()
+	remote, err := parseUpstreamQuota(body, now)
+	if err != nil {
+		memoizeUpstreamProbeUnsupported(ctx, s.accountRepo, account)
+		return
+	}
+	if remote.FiveHour != nil {
+		usage.FiveHour = remote.FiveHour
+	}
+	if remote.OneDay != nil {
+		usage.OneDay = remote.OneDay
+	}
+	if remote.SevenDay != nil {
+		usage.SevenDay = remote.SevenDay
+	}
+	if remote.ThirtyDay != nil {
+		usage.ThirtyDay = remote.ThirtyDay
+	}
+	usage.QuotaTotal = remote.QuotaTotal
+	usage.Balance = remote.Balance
+	usage.UpdatedAt = remote.UpdatedAt
+
+	var reported *UsageInfo
+	if usage.Error == "" {
+		reported = remote.UsageInfo
+	}
+	identity := ""
+	saveAPIKeyQuotaState(ctx, s.accountRepo, account, reported, remote.ExpiresAt, &identity)
+}
+
+func apiKeyQuotaExtraFloat(extra map[string]any, key string) (float64, bool) {
+	if len(extra) == 0 {
+		return 0, false
+	}
+	raw, ok := extra[key]
+	if !ok || raw == nil {
+		return 0, false
+	}
+	return parseExtraFloat64(raw), true
+}
+
+// APIKeyQuotaSchedulingUpdates merges reported sources with the current locked row.
+func APIKeyQuotaSchedulingUpdates(current map[string]any, usage *UsageInfo, now time.Time) (map[string]any, *time.Time) {
+	if usage == nil || usage.Error != "" {
+		return nil, nil
+	}
+	if usage.Balance == nil &&
+		usage.FiveHour == nil &&
+		usage.OneDay == nil &&
+		usage.SevenDay == nil &&
+		usage.ThirtyDay == nil &&
+		usage.QuotaTotal == nil {
+		return nil, nil
+	}
+	extraUpdates := make(map[string]any)
+	for _, key := range APIKeyQuotaSchedulingExtraKeys {
+		if value, ok := current[key]; ok {
+			extraUpdates[key] = value
+		}
+	}
+	balanceExhausted, _ := current[APIKeyQuotaBalanceExhaustedExtraKey].(bool)
+	if usage.Balance != nil {
+		balanceExhausted = *usage.Balance <= 0
+	}
+	extraUpdates[APIKeyQuotaBalanceExhaustedExtraKey] = balanceExhausted
+	undatedExhausted := balanceExhausted
+	var latestResetAt *time.Time
+	windows := []struct {
+		progress   *UsageProgress
+		usedKey    string
+		resetAtKey string
+	}{
+		{usage.FiveHour, APIKeyQuota5hUsedPercentExtraKey, APIKeyQuota5hResetAtExtraKey},
+		{usage.OneDay, APIKeyQuota1dUsedPercentExtraKey, APIKeyQuota1dResetAtExtraKey},
+		{usage.SevenDay, APIKeyQuota7dUsedPercentExtraKey, APIKeyQuota7dResetAtExtraKey},
+		{usage.ThirtyDay, APIKeyQuota30dUsedPercentExtraKey, APIKeyQuota30dResetAtExtraKey},
+		{usage.QuotaTotal, APIKeyQuotaTotalUsedPercentExtraKey, APIKeyQuotaTotalResetAtExtraKey},
+	}
+	for _, w := range windows {
+		if w.progress != nil {
+			extraUpdates[w.usedKey] = w.progress.Utilization
+			wantReset := ""
+			if w.progress.ResetsAt != nil {
+				wantReset = w.progress.ResetsAt.UTC().Format(time.RFC3339)
+			}
+			extraUpdates[w.resetAtKey] = wantReset
+		}
+		used, exists := apiKeyQuotaExtraFloat(extraUpdates, w.usedKey)
+		if !exists || used < 100 {
+			continue
+		}
+		resetAt := parseSchedulingResetAt(extraUpdates[w.resetAtKey])
+		if resetAt != nil && resetAt.After(now) {
+			if latestResetAt == nil || resetAt.After(*latestResetAt) {
+				latestResetAt = resetAt
+			}
+		} else if resetAt == nil || w.progress != nil {
+			// Keep reported exhaustion without a future reset. Retained dated windows expire.
+			undatedExhausted = true
+		}
+	}
+	extraUpdates[APIKeyQuotaExhaustedExtraKey] = undatedExhausted
+	return extraUpdates, latestResetAt
+}
