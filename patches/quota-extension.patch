 func (s *AccountUsageService) getUsageForAccount(ctx context.Context, account *Account, forceProbe bool) (*UsageInfo, error) {
+	if script := AccountQuotaScript(account); script != "" {
+		usage, err := s.ExecuteQuotaScript(ctx, account, script)
+		if err != nil {
+			return &UsageInfo{Error: err.Error()}, nil
+		}
+		return usage, nil
+	}
+	if account == nil || !IsUpstreamBillingProbeIdentity(account.Platform, account.Type) || account.GetCredential("base_url") == "" {
+		return s.getNativeUsageForAccount(ctx, account, forceProbe)
+	}
+	var usage *UsageInfo
+	if account.Platform == PlatformGemini || account.Platform == PlatformAntigravity || account.Platform == PlatformGrok {
+		var err error
+		usage, err = s.getNativeUsageForAccount(ctx, account, forceProbe)
+		if err != nil {
+			return usage, err
+		}
+	}
+	if usage == nil {
+		usage = &UsageInfo{}
+	}
+	baseURL := account.GetCredential("base_url")
+	if account.RoutesProtocolByInbound() && account.IsAdaptiveAPIProtocol() {
+		baseURL = account.GetCNProtocolBaseURL(APIProtocolChatCompletions)
+	}
+	parsed, parseErr := url.Parse(baseURL)
+	if parseErr == nil && parsed.Hostname() != "" && upstreamBillingProbeTargetIsOfficialAPI(baseURL) {
+		return usage, nil
+	}
+	s.fillUpstreamAPIKeyUsage(ctx, account, baseURL, usage)
+	return usage, nil
+}
