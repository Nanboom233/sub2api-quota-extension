+
+func (r *accountRepository) UpdateAPIKeyQuotaState(
+	ctx context.Context,
+	account *service.Account,
+	usage *service.UsageInfo,
+	expiresAt *time.Time,
+	unsupported *string,
+) (bool, error) {
+	if account == nil {
+		return false, service.ErrAccountNilInput
+	}
+	if account.ID <= 0 || (usage == nil && expiresAt == nil && unsupported == nil) {
+		return false, nil
+	}
+	if r == nil || r.client == nil {
+		return false, service.ErrUpstreamBillingProbeUnavailable
+	}
+	if scoped := r.accountTransactionScope(ctx); scoped != r {
+		return scoped.UpdateAPIKeyQuotaState(ctx, account, usage, expiresAt, unsupported)
+	}
+	updated := *account
+	updated.Extra = copyJSONMap(account.Extra)
+
+	if dbent.TxFromContext(ctx) == nil {
+		tx, err := r.client.Tx(ctx)
+		if errors.Is(err, dbent.ErrTxStarted) {
+			return r.updateAPIKeyQuotaStateInTx(ctx, r.client, account, usage, expiresAt, unsupported)
+		}
+		if err != nil {
+			return false, err
+		}
+		defer func() { _ = tx.Rollback() }()
+
+		applied, err := r.updateAPIKeyQuotaStateInTx(dbent.NewTxContext(ctx, tx), tx.Client(), &updated, usage, expiresAt, unsupported)
+		if err != nil || !applied {
+			return false, err
+		}
+		if err := tx.Commit(); err != nil {
+			return false, err
+		}
+		account.Extra = updated.Extra
+		account.ExpiresAt = updated.ExpiresAt
+		account.TempUnschedulableUntil = updated.TempUnschedulableUntil
+		account.TempUnschedulableReason = updated.TempUnschedulableReason
+		if usage != nil || expiresAt != nil {
+			r.syncSchedulerAccountSnapshotDetached(ctx, account.ID)
+		}
+		return true, nil
+	}
+	return r.updateAPIKeyQuotaStateInTx(ctx, clientFromContext(ctx, r.client), account, usage, expiresAt, unsupported)
+}
+
+func (r *accountRepository) updateAPIKeyQuotaStateInTx(
+	ctx context.Context,
+	client *dbent.Client,
+	account *service.Account,
+	usage *service.UsageInfo,
+	expiresAt *time.Time,
+	unsupported *string,
+) (bool, error) {
+	proxyMatches, err := lockAndMatchProbeProxyIdentity(ctx, client, account)
+	if err != nil {
+		return false, err
+	}
+	if !proxyMatches {
+		return false, nil
+	}
+
+	credentialsJSON, err := json.Marshal(normalizeJSONMap(account.Credentials))
+	if err != nil {
+		return false, err
+	}
+
+	var extraUpdates map[string]any
+	var pausedUntil *time.Time
+	if usage != nil && account.Type == service.AccountTypeAPIKey {
+		current, matched, err := lockAPIKeyQuotaSchedulingSources(ctx, client, account, string(credentialsJSON))
+		if err != nil || !matched {
+			return false, err
+		}
+		extraUpdates, pausedUntil = service.APIKeyQuotaSchedulingUpdates(current, usage, time.Now().UTC())
+	}
+	schedulingChanged := len(extraUpdates) > 0
+	if unsupported != nil {
+		if extraUpdates == nil {
+			extraUpdates = make(map[string]any, 1)
+		}
+		extraUpdates[service.APIKeyUsageUnsupportedIdentityExtraKey] = *unsupported
+	}
+
+	setClauses := make([]string, 0, 5)
+	changeClauses := make([]string, 0, 3)
+	args := make([]any, 0, 10)
+	idx := 1
+	expiryPlaceholder := ""
+
+	if len(extraUpdates) > 0 {
+		extraPayload, err := json.Marshal(extraUpdates)
+		if err != nil {
+			return false, err
+		}
+		setClauses = append(setClauses, "extra = COALESCE(extra, '{}'::jsonb) || $"+itoa(idx)+"::jsonb")
+		changeClauses = append(changeClauses, "(COALESCE(extra, '{}'::jsonb) || $"+itoa(idx)+"::jsonb) IS DISTINCT FROM COALESCE(extra, '{}'::jsonb)")
+		args = append(args, string(extraPayload))
+		idx++
+	}
+	if expiresAt != nil {
+		expiryPlaceholder = "$" + itoa(idx)
+		setClauses = append(setClauses, "expires_at = $"+itoa(idx))
+		changeClauses = append(changeClauses, "expires_at IS DISTINCT FROM "+expiryPlaceholder)
+		args = append(args, *expiresAt)
+		idx++
+	}
+	if schedulingChanged {
+		if pausedUntil != nil {
+			untilPlaceholder := "$" + itoa(idx)
+			args = append(args, *pausedUntil)
+			idx++
+			reasonPlaceholder := "$" + itoa(idx)
+			args = append(args, "apikey_quota_window_exhausted")
+			idx++
+			canSetExpr := "status = 'active' AND schedulable = TRUE AND (" +
+				"temp_unschedulable_until IS NULL " +
+				"OR temp_unschedulable_until <= NOW() " +
+				"OR COALESCE(temp_unschedulable_reason, '') LIKE 'apikey_quota_%')"
+			changeClauses = append(changeClauses, "("+canSetExpr+") AND (temp_unschedulable_until IS DISTINCT FROM "+untilPlaceholder+" OR temp_unschedulable_reason IS DISTINCT FROM "+reasonPlaceholder+")")
+			setClauses = append(
+				setClauses,
+				"temp_unschedulable_until = CASE WHEN "+canSetExpr+" THEN "+untilPlaceholder+" ELSE temp_unschedulable_until END",
+				"temp_unschedulable_reason = CASE WHEN "+canSetExpr+" THEN "+reasonPlaceholder+" ELSE temp_unschedulable_reason END",
+			)
+		} else {
+			changeClauses = append(changeClauses, "COALESCE(temp_unschedulable_reason, '') LIKE 'apikey_quota_%'")
+			setClauses = append(
+				setClauses,
+				"temp_unschedulable_until = CASE WHEN COALESCE(temp_unschedulable_reason, '') LIKE 'apikey_quota_%' THEN NULL ELSE temp_unschedulable_until END",
+				"temp_unschedulable_reason = CASE WHEN COALESCE(temp_unschedulable_reason, '') LIKE 'apikey_quota_%' THEN NULL ELSE temp_unschedulable_reason END",
+			)
+		}
+	}
+	if len(setClauses) == 0 {
+		return false, nil
+	}
+	if expiresAt != nil {
+		setClauses = append(setClauses, "updated_at = CASE WHEN expires_at IS DISTINCT FROM "+expiryPlaceholder+" THEN NOW() ELSE updated_at END")
+	}
+
+	var proxyID any
+	if account.ProxyID != nil {
+		proxyID = *account.ProxyID
+	}
+	expectedScript := normalizedAccountQuotaScript(account.Extra)
+
+	whereClause := " WHERE id = $" + itoa(idx) +
+		" AND deleted_at IS NULL" +
+		" AND platform = $" + itoa(idx+1) +
+		" AND type = $" + itoa(idx+2) +
+		" AND COALESCE(credentials, '{}'::jsonb) = $" + itoa(idx+3) + "::jsonb" +
+		" AND proxy_id IS NOT DISTINCT FROM $" + itoa(idx+4) +
+		" AND CASE WHEN BTRIM(COALESCE(extra ->> 'quota_script', '')) = '' THEN '' ELSE COALESCE(extra ->> 'quota_script', '') END = $" + itoa(idx+5)
+	args = append(args, account.ID, account.Platform, account.Type, string(credentialsJSON), proxyID, expectedScript)
+	whereClause += " AND (" + joinClauses(changeClauses, " OR ") + ")"
+
+	query := "UPDATE accounts SET " + joinClauses(setClauses, ", ") + whereClause
+	result, err := client.ExecContext(ctx, query, args...)
+	if err != nil {
+		return false, err
+	}
+	affected, err := result.RowsAffected()
+	if err != nil {
+		return false, err
+	}
+	if affected == 0 {
+		return false, nil
+	}
+	if schedulingChanged || expiresAt != nil {
+		if err := enqueueSchedulerOutbox(ctx, client, service.SchedulerOutboxEventAccountChanged, &account.ID, nil, nil); err != nil {
+			return false, err
+		}
+	}
+	if account.Extra == nil {
+		account.Extra = make(map[string]any, len(extraUpdates))
+	}
+	for key, value := range extraUpdates {
+		account.Extra[key] = value
+	}
+	if expiresAt != nil {
+		expiry := *expiresAt
+		account.ExpiresAt = &expiry
+	}
+	if schedulingChanged {
+		if pausedUntil == nil {
+			if strings.HasPrefix(account.TempUnschedulableReason, "apikey_quota_") {
+				account.TempUnschedulableUntil = nil
+				account.TempUnschedulableReason = ""
+			}
+		} else if account.IsActive() && account.Schedulable && (account.TempUnschedulableUntil == nil ||
+			!time.Now().Before(*account.TempUnschedulableUntil) || strings.HasPrefix(account.TempUnschedulableReason, "apikey_quota_")) {
+			account.TempUnschedulableUntil = pausedUntil
+			account.TempUnschedulableReason = "apikey_quota_window_exhausted"
+		}
+	}
+	return true, nil
+}
