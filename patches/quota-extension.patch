diff --git a/backend/internal/service/account_quota_script.go b/backend/internal/service/account_quota_script.go
new file mode 100644
index 0000000..e8c57c7
--- /dev/null
+++ b/backend/internal/service/account_quota_script.go
@@ -0,0 +1,374 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"maps"
+	"math"
+	"net/http"
+	"reflect"
+	"strings"
+	"time"
+
+	infraerrors "github.com/Wei-Shaw/sub2api/internal/pkg/errors"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/tlsfingerprint"
+	"github.com/Wei-Shaw/sub2api/internal/util/logredact"
+	"github.com/dop251/goja"
+)
+
+const QuotaScriptExtraKey = "quota_script"
+
+func AccountQuotaScript(account *Account) string {
+	if account == nil || account.Type != AccountTypeAPIKey {
+		return ""
+	}
+	script, _ := account.Extra[QuotaScriptExtraKey].(string)
+	if strings.TrimSpace(script) == "" {
+		return ""
+	}
+	return script
+}
+
+func normalizeQuotaScriptExtra(extra map[string]any) (map[string]any, error) {
+	value, provided := extra[QuotaScriptExtraKey]
+	if !provided {
+		return extra, nil
+	}
+	script, ok := value.(string)
+	if !ok {
+		return nil, infraerrors.BadRequest("INVALID_QUOTA_SCRIPT", "quota_script must be a string")
+	}
+	result := maps.Clone(extra)
+	if strings.TrimSpace(script) == "" {
+		delete(result, QuotaScriptExtraKey)
+	}
+	return result, nil
+}
+
+func (s *AccountUsageService) ExecuteQuotaScript(ctx context.Context, account *Account, script string) (usage *UsageInfo, err error) {
+	if account == nil || account.Type != AccountTypeAPIKey {
+		return nil, errors.New("Quota scripts require an API-key account")
+	}
+	if strings.TrimSpace(script) == "" {
+		return nil, errors.New("Quota script is empty")
+	}
+	ctx, cancel := context.WithTimeout(ctx, upstreamBillingProbeRequestTimeout)
+	defer cancel()
+	vm := goja.New()
+	vm.SetMaxCallStackSize(256)
+	finished := make(chan struct{})
+	defer close(finished)
+	go func() {
+		select {
+		case <-ctx.Done():
+			vm.Interrupt(ctx.Err())
+		case <-finished:
+		}
+	}()
+	defer func() {
+		if err == nil {
+			return
+		}
+		failure := err
+		diagnostic := "Quota script failed"
+		format, _ := goja.AssertFunction(vm.ToValue(func(goja.FunctionCall) goja.Value {
+			diagnostic = quotaScriptDiagnostic(account, failure)
+			return goja.Undefined()
+		}))
+		if _, formatErr := format(goja.Undefined()); formatErr != nil && ctx.Err() != nil {
+			diagnostic = ctx.Err().Error()
+		}
+		usage, err = nil, errors.New(diagnostic)
+	}()
+	if err = vm.Set("http", map[string]any{
+		"request": func(call goja.FunctionCall) goja.Value {
+			result, requestErr := s.quotaScriptRequest(ctx, account, call.Argument(0))
+			if requestErr != nil {
+				panic(vm.NewGoError(requestErr))
+			}
+			return vm.ToValue(result)
+		},
+	}); err != nil {
+		return nil, err
+	}
+	if _, err = vm.RunString(script); err != nil {
+		return nil, err
+	}
+	function, runErr := vm.RunString("queryQuota")
+	if runErr != nil {
+		return nil, runErr
+	}
+	query, ok := goja.AssertFunction(function)
+	if !ok {
+		return nil, errors.New("Define function queryQuota(ctx)")
+	}
+	baseURL := account.GetCredential("base_url")
+	if account.RoutesProtocolByInbound() && account.IsAdaptiveAPIProtocol() {
+		baseURL = account.GetCNProtocolBaseURL(APIProtocolChatCompletions)
+	}
+	result, callErr := query(goja.Undefined(), vm.ToValue(map[string]string{
+		"apiKey": account.GetCredential("api_key"), "baseUrl": baseURL,
+	}))
+	if callErr != nil {
+		return nil, callErr
+	}
+	validate, _ := goja.AssertFunction(vm.ToValue(func(call goja.FunctionCall) goja.Value {
+		var validationErr error
+		usage, validationErr = readQuotaScriptResult(call.Argument(0), time.Now())
+		if validationErr != nil {
+			panic(vm.NewGoError(validationErr))
+		}
+		return goja.Undefined()
+	}))
+	if _, err = validate(goja.Undefined(), result); err != nil {
+		return nil, err
+	}
+	if err = ctx.Err(); err != nil {
+		return nil, err
+	}
+	return usage, nil
+}
+
+func quotaScriptObject(value goja.Value, field string) (*goja.Object, error) {
+	object, ok := value.(*goja.Object)
+	if !ok || object.ClassName() != "Object" || object.ExportType() == reflect.TypeFor[*goja.Promise]() {
+		return nil, fmt.Errorf("%s must be an object", field)
+	}
+	return object, nil
+}
+
+func quotaScriptString(value goja.Value, field string) (string, error) {
+	if value == nil || goja.IsUndefined(value) || goja.IsNull(value) {
+		return "", fmt.Errorf("%s must be a string", field)
+	}
+	if _, object := value.(*goja.Object); object {
+		return "", fmt.Errorf("%s must be a string", field)
+	}
+	text, ok := value.Export().(string)
+	if !ok {
+		return "", fmt.Errorf("%s must be a string", field)
+	}
+	return text, nil
+}
+
+func quotaScriptNumber(value goja.Value, field string) (float64, error) {
+	if value == nil || goja.IsUndefined(value) || goja.IsNull(value) {
+		return 0, fmt.Errorf("%s must be a finite number", field)
+	}
+	if _, object := value.(*goja.Object); object {
+		return 0, fmt.Errorf("%s must be a finite number", field)
+	}
+	var number float64
+	switch primitive := value.Export().(type) {
+	case int64:
+		number = float64(primitive)
+	case float64:
+		number = primitive
+	default:
+		return 0, fmt.Errorf("%s must be a finite number", field)
+	}
+	if math.IsNaN(number) || math.IsInf(number, 0) {
+		return 0, fmt.Errorf("%s must be a finite number", field)
+	}
+	return number, nil
+}
+
+func quotaScriptPresent(value goja.Value) bool {
+	return value != nil && !goja.IsUndefined(value)
+}
+
+func readQuotaScriptResult(value goja.Value, now time.Time) (*UsageInfo, error) {
+	object, err := quotaScriptObject(value, "Result")
+	if err != nil {
+		return nil, err
+	}
+	usage := &UsageInfo{UpdatedAt: &now}
+	for _, window := range []struct {
+		key string
+		out **UsageProgress
+	}{
+		{"session", &usage.FiveHour}, {"day", &usage.OneDay}, {"week", &usage.SevenDay},
+		{"month", &usage.ThirtyDay}, {"total", &usage.QuotaTotal},
+	} {
+		raw := object.Get(window.key)
+		if !quotaScriptPresent(raw) {
+			continue
+		}
+		amount, err := quotaScriptObject(raw, window.key)
+		if err != nil {
+			return nil, err
+		}
+		used, err := quotaScriptNumber(amount.Get("used"), window.key+".used")
+		if err != nil {
+			return nil, err
+		}
+		limit, err := quotaScriptNumber(amount.Get("limit"), window.key+".limit")
+		if err != nil {
+			return nil, err
+		}
+		if used < 0 || limit <= 0 {
+			return nil, fmt.Errorf("%s requires used >= 0 and limit > 0", window.key)
+		}
+		progress := &UsageProgress{Utilization: used / limit * 100}
+		if math.IsInf(progress.Utilization, 0) {
+			return nil, fmt.Errorf("%s utilization is not finite", window.key)
+		}
+		if reset := amount.Get("reset_at"); quotaScriptPresent(reset) {
+			text, err := quotaScriptString(reset, window.key+".reset_at")
+			if err != nil {
+				return nil, err
+			}
+			timestamp, err := time.Parse(time.RFC3339, text)
+			if err != nil {
+				return nil, fmt.Errorf("%s.reset_at must be RFC 3339 text", window.key)
+			}
+			progress.ResetsAt = &timestamp
+			progress.RemainingSeconds = max(0, int(timestamp.Sub(now).Seconds()))
+		}
+		*window.out = progress
+	}
+	if balance := object.Get("balance"); quotaScriptPresent(balance) {
+		amount := balance
+		var unit goja.Value
+		if balanceObject, ok := balance.(*goja.Object); ok {
+			if balanceObject.ClassName() != "Object" {
+				return nil, errors.New("balance must be a number or an amount object")
+			}
+			amount = balanceObject.Get("amount")
+			if nestedUnit := balanceObject.Get("unit"); quotaScriptPresent(nestedUnit) {
+				unit = nestedUnit
+			}
+		}
+		if !quotaScriptPresent(unit) {
+			unit = object.Get("unit")
+		}
+		number, err := quotaScriptNumber(amount, "balance")
+		if err != nil {
+			return nil, err
+		}
+		usage.Balance = &number
+		if quotaScriptPresent(unit) {
+			text, err := quotaScriptString(unit, "unit")
+			if err != nil {
+				return nil, err
+			}
+			usage.BalanceUnit = strings.TrimSpace(text)
+			if usage.BalanceUnit == "" {
+				return nil, errors.New("unit must not be blank")
+			}
+		}
+	}
+	return usage, nil
+}
+
+func (s *AccountUsageService) quotaScriptRequest(ctx context.Context, account *Account, value goja.Value) (map[string]any, error) {
+	request, err := quotaScriptObject(value, "HTTP request")
+	if err != nil {
+		return nil, err
+	}
+	rawURL, err := quotaScriptString(request.Get("url"), "url")
+	if err != nil {
+		return nil, err
+	}
+	target, err := validateAccountUpstreamBaseURL(s.upstreamConfig, rawURL)
+	if err != nil {
+		return nil, fmt.Errorf("HTTP URL: %w", err)
+	}
+	method := http.MethodGet
+	if raw := request.Get("method"); quotaScriptPresent(raw) {
+		method, err = quotaScriptString(raw, "method")
+		if err != nil {
+			return nil, err
+		}
+	}
+	body := ""
+	if raw := request.Get("body"); quotaScriptPresent(raw) {
+		body, err = quotaScriptString(raw, "body")
+		if err != nil {
+			return nil, err
+		}
+	}
+	req, err := http.NewRequestWithContext(ctx, method, target, strings.NewReader(body))
+	if err != nil {
+		return nil, fmt.Errorf("HTTP request: %w", err)
+	}
+	if raw := request.Get("headers"); quotaScriptPresent(raw) {
+		headers, err := quotaScriptObject(raw, "headers")
+		if err != nil {
+			return nil, err
+		}
+		for _, key := range headers.Keys() {
+			text, err := quotaScriptString(headers.Get(key), "header value")
+			if err != nil {
+				return nil, err
+			}
+			req.Header.Set(key, text)
+		}
+	}
+	if s.upstreamHTTP == nil {
+		return nil, errors.New("HTTP transport is not configured")
+	}
+	proxyURL := ""
+	if account.ProxyID != nil {
+		if account.Proxy == nil || account.Proxy.ID != *account.ProxyID {
+			return nil, errors.New("Account proxy is not available")
+		}
+		proxyURL = account.Proxy.URL()
+	}
+	profile := HTTPUpstreamProfileDefault
+	if account.Platform == PlatformOpenAI {
+		profile = HTTPUpstreamProfileOpenAI
+	}
+	req = req.WithContext(WithHTTPUpstreamRedirectsDisabled(WithHTTPUpstreamProfile(req.Context(), profile)))
+	account.ApplyHeaderOverrides(req.Header)
+	var tlsProfile *tlsfingerprint.Profile
+	if s.tlsFPProfileService != nil {
+		tlsProfile = s.tlsFPProfileService.ResolveTLSProfile(account)
+	}
+	response, err := s.upstreamHTTP.DoWithTLS(req, proxyURL, account.ID, account.Concurrency, tlsProfile)
+	if response != nil && response.Body != nil {
+		defer response.Body.Close()
+	}
+	if err != nil {
+		return nil, fmt.Errorf("HTTP request failed: %w", err)
+	}
+	if response == nil || response.Body == nil {
+		return nil, errors.New("HTTP response body is missing")
+	}
+	data, err := io.ReadAll(io.LimitReader(response.Body, upstreamBillingProbeMaxBodyBytes+1))
+	if err != nil {
+		return nil, fmt.Errorf("HTTP response read failed: %w", err)
+	}
+	if len(data) > upstreamBillingProbeMaxBodyBytes {
+		return nil, errors.New("HTTP response exceeds 64 KiB")
+	}
+	return map[string]any{"status": response.StatusCode, "body": string(data)}, nil
+}
+
+func quotaScriptDiagnostic(account *Account, err error) string {
+	message := logredact.RedactText(err.Error())
+	for _, key := range SensitiveCredentialKeys {
+		if secret := account.GetCredential(key); secret != "" {
+			message = strings.ReplaceAll(message, secret, "[redacted]")
+		}
+	}
+	if account.Proxy != nil {
+		for _, secret := range []string{account.Proxy.URL(), account.Proxy.Username, account.Proxy.Password} {
+			if secret != "" {
+				message = strings.ReplaceAll(message, secret, "[redacted]")
+			}
+		}
+	}
+	headers := make(http.Header)
+	account.ApplyHeaderOverrides(headers)
+	for _, values := range headers {
+		for _, secret := range values {
+			if secret != "" {
+				message = strings.ReplaceAll(message, secret, "[redacted]")
+			}
+		}
+	}
+	return message
+}
